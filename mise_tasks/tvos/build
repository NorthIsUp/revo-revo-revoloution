#!/usr/bin/env zsh
#MISE description="Build RRRevoloution for tvOS simulator"
#MISE depends=["tvos:configure"]
#MISE sources=["src/**/*", "extern/**/*"]
#MISE outputs=["{{env.TVOS_APP}}/RRRevoloution-debug"]
set -euo pipefail
# Address the simulator by name, not UDID: an older runtime still installed
# alongside the current one also has a device by this name, and xcodebuild
# rejects it as ineligible ("tvOS <version> is not installed"). By name,
# xcodebuild picks the newest runtime it can actually build against.
xcodebuild -project "$TVOS_BUILD_DIR/StepMania.xcodeproj" \
  -scheme RRRevoloution \
  -destination "platform=tvOS Simulator,name=$TVOS_SIM_DEVICE" \
  build

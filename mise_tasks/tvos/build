#!/usr/bin/env zsh
#MISE description="Build ITGmania for tvOS simulator"
#MISE depends=["tvos:configure"]
#MISE sources=["src/**/*", "extern/**/*"]
#MISE outputs=["{{env.TVOS_APP}}/ITGmania-debug"]
set -euo pipefail
SIM_ID=$(xcrun simctl list devices available | grep "$TVOS_SIM_DEVICE" | head -1 | grep -oE '[0-9A-F-]{36}')
if [ -z "$SIM_ID" ]; then
  echo "Error: no available simulator matching '$TVOS_SIM_DEVICE'"
  exit 1
fi
xcodebuild -project "$TVOS_BUILD_DIR/StepMania.xcodeproj" \
  -scheme ITGmania \
  -destination "platform=tvOS Simulator,id=$SIM_ID" \
  build

#!/usr/bin/env zsh
#MISE description="Stream logs from the running tvOS app"
set -euo pipefail

SIM_ID=$(xcrun simctl list devices available \
  | awk -v n="$TVOS_SIM_DEVICE" '{ l=$0; sub(/^ +/, "", l); if (index(l, n " (") == 1) print l }' \
  | tail -1 | grep -oE '[0-9A-F-]{36}')
CONTAINER=$(xcrun simctl get_app_container "$SIM_ID" "$TVOS_BUNDLE_ID" data 2>/dev/null)
LOG="$CONTAINER/Library/Caches/Logs/log.txt"
if [ -f "$LOG" ]; then
  tail -f "$LOG"
else
  echo "No log file found at '$LOG'. Is the app running?"
  exit 1
fi

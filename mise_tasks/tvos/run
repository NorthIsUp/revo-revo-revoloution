#!/usr/bin/env zsh
#MISE description="Install and launch RRRevoloution on tvOS simulator"
#MISE depends=["tvos:build"]
#MISE alias="tvos:sim"
set -euo pipefail

# An older runtime installed alongside the current one has a device by the
# same name that xcodebuild won't build against, so match the name exactly and
# take the newest — simctl lists runtimes oldest-first.
SIM_ID=$(xcrun simctl list devices available \
  | awk -v n="$TVOS_SIM_DEVICE" '{ l=$0; sub(/^ +/, "", l); if (index(l, n " (") == 1) print l }' \
  | tail -1 | grep -oE '[0-9A-F-]{36}')

# Boot simulator if needed
STATE=$(xcrun simctl list devices | grep "$SIM_ID" | grep -o '(Booted)') || true
if [ -z "$STATE" ]; then
  echo "Booting simulator..."
  xcrun simctl boot "$SIM_ID"
  open -a Simulator
  sleep 5
fi

xcrun simctl terminate "$SIM_ID" "$TVOS_BUNDLE_ID" 2>/dev/null || true
xcrun simctl install "$SIM_ID" "$TVOS_APP"
xcrun simctl launch "$SIM_ID" "$TVOS_BUNDLE_ID"
echo "Launched $TVOS_BUNDLE_ID on $TVOS_SIM_DEVICE"

#!/usr/bin/env zsh
#MISE description="Install and launch ITGmania on tvOS simulator"
#MISE depends=["tvos:build"]
#MISE alias="tvos:sim"
set -euo pipefail

SIM_ID=$(xcrun simctl list devices available | grep "$TVOS_SIM_DEVICE" | head -1 | grep -oE '[0-9A-F-]{36}')

# Boot simulator if needed
STATE=$(xcrun simctl list devices | grep "$SIM_ID" | grep -o '(Booted)') || true
if [ -z "$STATE" ]; then
  echo "Booting simulator..."
  xcrun simctl boot "$SIM_ID"
  open -a Simulator
  sleep 5
fi

xcrun simctl terminate "$SIM_ID" "$TVOS_BUNDLE_ID" 2>/dev/null || true
xcrun simctl install "$SIM_ID" "$TVOS_APP"
xcrun simctl launch "$SIM_ID" "$TVOS_BUNDLE_ID"
echo "Launched $TVOS_BUNDLE_ID on $TVOS_SIM_DEVICE"
